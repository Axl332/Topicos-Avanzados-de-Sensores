// =============================================================
//  CAJA NEGRA - IPN UPIIZ  |  Tópicos Avanzados de Sensores
//  ESP32 DevKit V1
//  Sensores: MPU6050 · BMP280+AHT20 · GPS Neo-6M
// =============================================================

#include <Wire.h>
#include <MPU6050.h>            // ElectronicCats/MPU6050
#include <Adafruit_BMP280.h>   // Adafruit BMP280
#include <Adafruit_AHTX0.h>    // Adafruit AHTX0 (AHT20)
#include <TinyGPSPlus.h>       // mikalhart/TinyGPSPlus
#include <HardwareSerial.h>

// ─── Pines I2C ───────────────────────────────────────────────
#define SDA_PIN 21
#define SCL_PIN 22

// ─── Pines UART GPS ──────────────────────────────────────────
#define GPS_RX_PIN 16   // ESP32 RX2 ← Neo-6M TX
#define GPS_TX_PIN 17   // ESP32 TX2 → Neo-6M RX

// ─── Umbrales de alerta ──────────────────────────────────────
#define UMBRAL_GOLPE       2.5f   // g (magnitud aceleración total)
#define UMBRAL_VOLCADO     60.0f  // grados de inclinación
#define TEMP_MAX           45.0f  // °C
#define TEMP_MIN            0.0f  // °C
#define HUMEDAD_MAX        85.0f  // %

// ─── Intervalo de muestreo normal ────────────────────────────
#define INTERVALO_MS       1000   // ms

// ─── Objetos de sensores ─────────────────────────────────────
MPU6050          mpu;
Adafruit_BMP280  bmp;
Adafruit_AHTX0   aht;
TinyGPSPlus      gps;
HardwareSerial   gpsSerial(2);   // UART2 del ESP32

// ─── Variables de estado ─────────────────────────────────────
float lat_incidente = 0.0;
float lon_incidente = 0.0;
bool  gps_valido    = false;
unsigned long t_anterior = 0;

// =============================================================
//  Estructura de incidente (se puede guardar en SPIFFS/SD)
// =============================================================
struct Incidente {
  String tipo;
  float  valor;
  float  lat;
  float  lon;
  bool   gps_ok;
};

// =============================================================
//  SETUP
// =============================================================
void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);

  Serial.println("\n=== CAJA NEGRA - INICIANDO ===");

  // I2C
  Wire.begin(SDA_PIN, SCL_PIN);

  // GPS (Neo-6M a 9600 baud por defecto)
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  Serial.println("[GPS] UART2 iniciado @ 9600 baud");

  // ── MPU6050 ──────────────────────────────────────────────
  mpu.initialize();
  mpu.setFullScaleAccelRange(MPU6050_ACCEL_FS_4); // ±4g
  mpu.setFullScaleGyroRange(MPU6050_GYRO_FS_500);

  if (mpu.testConnection()) {
    Serial.println("[MPU6050] OK — dirección 0x68");
  } else {
    Serial.println("[MPU6050] ERROR: no detectado. Revisa SDA/SCL/VCC");
  }

  // ── BMP280 ───────────────────────────────────────────────
  // Dirección SDO→GND = 0x76 | SDO→VCC = 0x77
  if (bmp.begin(0x76)) {
    bmp.setSampling(Adafruit_BMP280::MODE_NORMAL,
                    Adafruit_BMP280::SAMPLING_X2,    // temperatura
                    Adafruit_BMP280::SAMPLING_X16,   // presión
                    Adafruit_BMP280::FILTER_X16,
                    Adafruit_BMP280::STANDBY_MS_500);
    Serial.println("[BMP280] OK — dirección 0x76");
  } else {
    Serial.println("[BMP280] ERROR: no detectado. Prueba 0x77 si SDO=VCC");
  }

  // ── AHT20 ────────────────────────────────────────────────
  if (aht.begin()) {
    Serial.println("[AHT20]  OK — dirección 0x38");
  } else {
    Serial.println("[AHT20]  ERROR: no detectado. Revisa SDA/SCL/VCC");
  }

  Serial.println("=== SISTEMA LISTO ===\n");
}

// =============================================================
//  LOOP
// =============================================================
void loop() {
  // ── Alimentar parser GPS (no bloqueante) ─────────────────
  while (gpsSerial.available() > 0) {
    gps.encode(gpsSerial.read());
  }

  // Guardar posición GPS si es válida
  if (gps.location.isUpdated() && gps.location.isValid()) {
    lat_incidente = gps.location.lat();
    lon_incidente = gps.location.lng();
    gps_valido    = true;
  }

  // ── Muestreo cada INTERVALO_MS ───────────────────────────
  unsigned long ahora = millis();
  if (ahora - t_anterior < INTERVALO_MS) return;
  t_anterior = ahora;

  // ── Leer MPU6050 ─────────────────────────────────────────
  int16_t ax_raw, ay_raw, az_raw, gx_raw, gy_raw, gz_raw;
  mpu.getMotion6(&ax_raw, &ay_raw, &az_raw,
                 &gx_raw, &gy_raw, &gz_raw);

  // Escala ±4g → divisor 8192 LSB/g
  float ax = ax_raw / 8192.0f;
  float ay = ay_raw / 8192.0f;
  float az = az_raw / 8192.0f;

  float mag = sqrt(ax*ax + ay*ay + az*az);  // magnitud total en g

  // Ángulos de inclinación (roll & pitch)
  float roll  = atan2(ay, az)             * 180.0f / PI;
  float pitch = atan2(-ax, sqrt(ay*ay + az*az)) * 180.0f / PI;

  // ── Leer BMP280 + AHT20 ──────────────────────────────────
  float presion   = bmp.readPressure() / 100.0f;  // hPa
  float temp_bmp  = bmp.readTemperature();         // °C (respaldo)

  sensors_event_t evt_h, evt_t;
  aht.getEvent(&evt_h, &evt_t);
  float humedad   = evt_h.relative_humidity;       // %
  float temp_aht  = evt_t.temperature;             // °C (principal)

  // ── Detección de eventos ──────────────────────────────────
  if (mag > UMBRAL_GOLPE) {
    registrarIncidente("GOLPE", mag);
  }

  if (abs(roll) > UMBRAL_VOLCADO || abs(pitch) > UMBRAL_VOLCADO) {
    registrarIncidente("VOLCADO", max(abs(roll), abs(pitch)));
  }

  if (temp_aht > TEMP_MAX) {
    registrarIncidente("TEMP_ALTA", temp_aht);
  } else if (temp_aht < TEMP_MIN) {
    registrarIncidente("TEMP_BAJA", temp_aht);
  }

  if (humedad > HUMEDAD_MAX) {
    registrarIncidente("HUMEDAD_ALTA", humedad);
  }

  // ── Telemetría por Serial ─────────────────────────────────
  Serial.println("─────────────────────────────────");
  Serial.printf("[ACCEL]  X=%.2fg  Y=%.2fg  Z=%.2fg  |  MAG=%.2fg\n",
                ax, ay, az, mag);
  Serial.printf("[IMU]    Roll=%.1f°  Pitch=%.1f°\n", roll, pitch);
  Serial.printf("[AHT20]  Temp=%.2f°C  Hum=%.1f%%\n", temp_aht, humedad);
  Serial.printf("[BMP280] Temp=%.2f°C  Presion=%.2f hPa\n",
                temp_bmp, presion);

  if (gps_valido) {
    Serial.printf("[GPS]    Lat=%.6f  Lon=%.6f  Sats=%d\n",
                  lat_incidente, lon_incidente, gps.satellites.value());
  } else {
    Serial.printf("[GPS]    Buscando señal...  Chars=%d\n",
                  gps.charsProcessed());
  }
}

// =============================================================
//  Registrar incidente con posición GPS
// =============================================================
void registrarIncidente(const String& tipo, float valor) {
  Incidente inc;
  inc.tipo   = tipo;
  inc.valor  = valor;
  inc.lat    = lat_incidente;
  inc.lon    = lon_incidente;
  inc.gps_ok = gps_valido;

  Serial.println("\n★★★ INCIDENTE DETECTADO ★★★");
  Serial.println("  Tipo : " + tipo);
  Serial.printf("  Valor: %.2f\n", valor);
  if (inc.gps_ok) {
    Serial.printf("  GPS  : Lat=%.6f  Lon=%.6f\n", inc.lat, inc.lon);
    Serial.println("  Maps : https://maps.google.com/?q=" +
                   String(inc.lat, 6) + "," + String(inc.lon, 6));
  } else {
    Serial.println("  GPS  : Sin señal al momento del incidente");
  }
  Serial.println("★★★★★★★★★★★★★★★★★★★★★★★★\n");

  // TODO: Guardar en SPIFFS 

}

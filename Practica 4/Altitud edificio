#include <Wire.h>
#include <Adafruit_BMP085.h>

Adafruit_BMP085 bmp;

void setup() {
  Serial.begin(9600);

  if (!bmp.begin()) {
    Serial.println("No se encontró el BMP180, verifica conexiones.");
    while (1);
  }

  Serial.println("=== Medición de Altitud BMP180 ===");
  Serial.println("Presión(Pa)\tAltitud(m)");
}

void loop() {
  float presion  = bmp.readPressure();       // Pa
  float altitud  = bmp.readAltitude();       // metros (nivel del mar estándar)

  Serial.print(presion, 2);
  Serial.print("\t");
  Serial.println(altitud, 2);

  delay(1000); // lectura cada segundo
}
